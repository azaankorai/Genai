# Set secrets in your hosting dashboard, never in source control.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
# Only enable behind a trusted reverse proxy that appends the actual client IP.
TRUST_PROXY=0
BUSINESS_NAME=FrameForge
SUPPORT_EMAIL=

# Resend: verify a sending domain, then set a sender on that domain.
RESEND_API_KEY=
EMAIL_FROM=

# fal.ai: server-side generation key; maintain a funded provider balance.
FAL_KEY=

# Stripe: start with TEST keys and TEST recurring monthly Price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
CREATOR_MONTHLY_CREDITS=200
STUDIO_MONTHLY_CREDITS=600
# Enable only after business details, pricing, terms and webhook tests are complete.
ENABLE_BILLING=0
